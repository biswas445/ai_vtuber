# --- LLM (Groq) ---
GROQ_API_KEY=ENTER_YOUR_API_KEY_HERE
LLM_MODEL=qwen/qwen3.8-27b




# --- STT (faster-whisper) ---
# distil-small.en is ~2x faster than distil-medium.en and still solid for
# casual spoken English (put distil-medium.en back for maximum accuracy).
STT_MODEL=distil-large-v2
STT_DEVICE=cuda
# compute precision: float32 (full fp32), float16, or int8_float16
STT_COMPUTE_TYPE=float32





# --- TTS (Pocket TTS) ---
# device: cuda or cpu (pocket tts is designed to be fast on cpu too)
TTS_DEVICE=cuda
# voice: a preset name (azelma, alba, eve, ...), an hf:// URL, a local audio
# file (wav/mp3/flac/ogg/...), or a folder holding one reference clip (+ an
# optional reference .txt alongside it — logged at startup). The model clones
# the speaker from the audio.
TTS_VOICE=D:\evil\pocket_tts\evil_voice\audio.wav
# model precision: float32 (full fp32), float16, bfloat16 — every weight,
# buffer and voice state follows this
TTS_DTYPE=float32




# --- VAD (silero) ---
VAD_THRESHOLD=0.8
# how long (ms) of silence before the user is considered done talking
VAD_MIN_SILENCE_MS=600
VAD_SPEECH_PAD_MS=300
# cpu is intentional: silero is tiny and cpu gives the lowest per-chunk latency
VAD_DEVICE=cpu
# model precision: float32 only — sileros TorchScript internals cannot run
# at fp16/bf16 (rejected at load with a clear error)
VAD_DTYPE=float32
# Speech-only gate (see pocket_tts/vad.py speech_verdict): a captured burst
# only reaches the STT when at least this fraction of it was scored as speech
# by the neural model...
VAD_MIN_VOICED_FRACTION=0.35
# ...and its energy is at least this many times the ambient noise floor.
# Raise these if background noise still gets through; lower them if your
# quiet voice gets dropped.
VAD_NOISE_MARGIN=3.0




# --- Audio devices (optional) ---
# Leave empty to use the system default. Or put part of a device name to pin it,
# e.g. INPUT_DEVICE=Microphone so only the mic is heard (never speaker loopback).
INPUT_DEVICE=
OUTPUT_DEVICE=

# --- Conversation ---
MAX_HISTORY_TURNS=12
